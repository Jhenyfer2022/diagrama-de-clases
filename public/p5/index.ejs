  import { Component, OnInit } from '@angular/core';
  import { ActivatedRoute } from '@angular/router';
  import { DiagramasService } from '../../servicios/diagramas.service';

  @Component({
    selector: 'app-class-detail',
    templateUrl: './class-detail.component.html',
    styleUrls: ['./class-detail.component.css']
  })
  export class ClassDetailComponent implements OnInit {
    classData: any = null;
    attributes: string[] = [];
    attributeValues: { [key: string]: string } = {};

    constructor(
      private route: ActivatedRoute,
      private diagramasService: DiagramasService
    ) {}

    ngOnInit(): void {
      const id = Number(this.route.snapshot.paramMap.get('id'));
      this.classData = this.diagramasService.getClassById(id);
      if (this.classData && this.classData.atributo && this.classData.atributo !== '{atributo}') {
        // Handle atributo as string or array
        this.attributes = Array.isArray(this.classData.atributo)
          ? this.classData.atributo
          : typeof this.classData.atributo === 'string'
          ? this.classData.atributo.split(',').map((attr: string) => attr.trim())
          : [];
        // Initialize attribute values
        this.attributes.forEach(attr => {
          this.attributeValues[attr] = '';
        });
      }
      // Fallback attributes if none defined
      if (!this.attributes.length) {
        this.attributes = ['id', 'name']; // Default attributes
        this.attributes.forEach(attr => {
          this.attributeValues[attr] = '';
        });
      }
    }

    goBack(): void {
      window.history.back();
    }
  }
    `.trim());

