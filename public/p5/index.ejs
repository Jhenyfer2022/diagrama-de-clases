        console.log(objetosRecuperados);
        draw2(objetosRecuperados); // Ajusta el método a lo que necesites dibujar.
      };

      reader.readAsText(file[0]); // Lee el archivo XML.
      campoParaSubirArchivo.value = null;
      ocultarModalImportar(); // Oculta el modal después de la importación.

    } catch (error) {
      alert('Ocurrió un error al importar');
      console.error(error);
    }
