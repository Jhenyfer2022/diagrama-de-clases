  function importar() {
    try {
      let file = campoParaSubirArchivo.files;
      const reader = new FileReader();
      reader.onload = function (event) {
        let parser = new DOMParser();
        let xmlDoc = parser.parseFromString(event.target.result, "text/xml");

        // Ejemplo: Extraer elementos de clases desde el XML
        let clases = xmlDoc.getElementsByTagName("UML:Class");
        let objetosRecuperados = [];

        for (let i = 0; i < clases.length; i++) {
          let nombreClase = clases[i].getAttribute("name");
          // Puedes seguir extrayendo atributos, métodos, etc.
          objetosRecuperados.push({
            nombre: nombreClase,
            // Otros atributos que quieras extraer
          });
